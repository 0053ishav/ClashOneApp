# Public runtime configuration used by the Expo client.
# Do not put secrets in EXPO_PUBLIC_* variables; they are embedded in the app bundle.

EXPO_PUBLIC_APP_LINK=
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_CDN_BASE=
EXPO_PUBLIC_BACKEND_EMAIL=
EXPO_PUBLIC_PRIMARY_COLOR=
EXPO_PUBLIC_ENV=

# Legacy public header value. This is visible in the app bundle and must not be
# treated as authentication or authorization. Player lookups are public and
# protected by server-side rate limits instead.
EXPO_PUBLIC_APP_KEY=

# Temporary compatibility fallback for existing local/EAS builds; remove once
# all build profiles have migrated to EXPO_PUBLIC_APP_KEY.
EXPO_PUBLIC_APP_SECRET=
