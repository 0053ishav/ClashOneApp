# Public runtime configuration used by the Expo client.
# Do not put secrets in EXPO_PUBLIC_* variables; they are embedded in the app bundle.

EXPO_PUBLIC_APP_LINK=
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_CDN_BASE=
EXPO_PUBLIC_BACKEND_EMAIL=
EXPO_PUBLIC_PRIMARY_COLOR=
EXPO_PUBLIC_ENV=

# Public client identifier sent as x-app-key. It is visible in the app bundle
# and is not an authentication secret. The backend must not rely on it as the
# sole authorization or abuse-prevention control.
EXPO_PUBLIC_APP_KEY=

# Legacy compatibility only. Migrate old local/EAS configuration to
# EXPO_PUBLIC_APP_KEY after confirming the backend does not treat this value
# as a secret. This fallback will be removed in a later change.
EXPO_PUBLIC_APP_SECRET=
